( Clamp a byte to the printable range (anything else draws `?`). )
glyph_clamp :: fn(c: u8) -> u8 {
    if c < 32 {
        return 63;
    }
    if c > 126 {
        return 63;
    }
    return c;
}

( ROM address of a printable glyph's first row (clamp first). )
glyph_addr :: fn(ch: u8) -> u16 {
    g: u16 = ch - 32;
    return &font8x8 + g * 8;
}

( Blit one printable glyph cell; clamps, so any byte is safe. )
macro draw_char(x: u16, y: u16, ch: u8) {
    draw_char_mode(x, y, ch, SPRITE_NORM);
}

macro draw_char_mode(x: u16, y: u16, ch: u8, mode: u8) {
    blit(x, y, glyph_addr(glyph_clamp(ch)), mode);
}

( Walk a NUL-terminated string (literal or buffer), 8px per cell,
  `\n` starts the next row. )
macro draw_string(x: u16, y: u16, s: &u8) {
    cx: u16 = x;
    cy: u16 = y;
    i: u16 = 0;
    c: u8 = s[i];
    while c != 0 {
        if c == 10 {
            cx = x;
            cy = cy + 8;
        } else {
            draw_char(cx, cy, c);
            cx = cx + 8;
        }
        i = i + 1;
        c = s[i];
    }
}
