( fix16 stdlib harness: core ops with Python-computed vectors.
  Each u16 result prints as hi,lo bytes. Expected console bytes:
  01 00 06 00 00 40 fe 00 06 00 00 02 7f ff 00 1a
  00 80 01 80 00 40 01 00 03 55 fe 80 00 55 7f ff
  00 00 03 00 01 00 ff 00 00 00 02 00 01 00 02 00
  7f ff ff 00 00 00 01 00 fe 00 01 00 80 01 02 00
  ff 00 01 00 7f ff 00 00 00 01 ff ff 00 02 ff ff
  05 00 7f 00 7f ff
  (mul x8, div x9, add/sub/neg, round x7, floor x4, ceil x5,
  to_int x4, from_int x3. floor(-127.996) saturates to #8001 —
  the true floor -128 is unrepresentable.) )
import "fix16.ux"

emit16 :: fn(v: u16) {
    varvara.console.write((v >> 8) & 255);
    varvara.console.write(v & 255);
}

main :: fn() {
    emit16(x16_mul(256, 256));
    emit16(x16_mul(512, 768));
    emit16(x16_mul(128, 128));
    emit16(x16_mul(65280, 512));
    emit16(x16_mul(65024, 64768));
    emit16(x16_mul(26, 26));
    emit16(x16_mul(32512, 32512));
    emit16(x16_mul(26, 256));
    emit16(x16_div(256, 512));
    emit16(x16_div(768, 512));
    emit16(x16_div(256, 1024));
    emit16(x16_div(256, 256));
    emit16(x16_div(2560, 768));
    emit16(x16_div(64768, 512));
    emit16(x16_div(256, 768));
    emit16(x16_div(256, 0));
    emit16(x16_div(0, 1280));
    emit16(x16_add(256, 512));
    emit16(x16_sub(512, 256));
    emit16(x16_neg(256));
    emit16(x16_round(128));
    emit16(x16_round(384));
    emit16(x16_round(320));
    emit16(x16_round(448));
    emit16(x16_round(32640));
    emit16(x16_round(65280));
    emit16(x16_round(65408));
    emit16(x16_floor(384));
    emit16(x16_floor(65152));
    emit16(x16_floor(256));
    emit16(x16_floor(32769));
    emit16(x16_ceil(384));
    emit16(x16_ceil(65152));
    emit16(x16_ceil(256));
    emit16(x16_ceil(32767));
    emit16(x16_ceil(65281));
    emit16(x16_to_int(384));
    emit16(x16_to_int(65152));
    emit16(x16_to_int(512));
    emit16(x16_to_int(65280));
    emit16(x16_from_int(5));
    emit16(x16_from_int(127));
    emit16(x16_from_int(200));
}
